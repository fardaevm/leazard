# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI key used for analysis and law-corpus embeddings.
OPENAI_API_KEY=
# JWT signing secret, at least 32 chars. Generate: openssl rand -hex 32
SECRET_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
# Changing this re-embeds the law corpus on next start.
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ── Paths (local dev defaults; the Docker image overrides these to /data/...) ─
# DATABASE_URL=sqlite:///./leaze.db
UPLOAD_DIR=uploads
LAW_DIR=data/law
RAG_STORE_DIR=rag_store
RAG_INDEX_NAME=sf_law_faiss
# MARKET_NORMS_PATH=rag/market_norms.md

# ── Auth / limits ─────────────────────────────────────────────────────────────
TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=10
# Jobs run in-process; keep the server at ONE uvicorn worker.
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_S=240
MIN_PDF_TEXT_CHARS=200

# ── Scope ─────────────────────────────────────────────────────────────────────
SUPPORTED_ZIP_PREFIXES=94,95
SUPPORTED_REGION=San Francisco / California Bay Area

# ── RAG tuning (changing chunk settings re-embeds the corpus) ─────────────────
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_CONTEXT_MAX_CHARS=5000
# RAG_MAX_DISTANCE=

# ── Analysis tuning (optional; defaults shown) ────────────────────────────────
# SEVERITY_WEIGHTS=OK:0,Low:0.5,Medium:1.5,High:3
# CALIBRATION_PASS=false
# QUOTE_MATCH_RATIO=0.9
# CITATION_MIN_OVERLAP=2
# MAX_CATEGORIES=12
# LEASE_EXTRACT_CHARS=100000
# LEASE_CHUNK_CHARS=24000
# LEASE_CHUNK_OVERLAP=500
# EXCERPT_WINDOW_CHARS=900
# EXCERPT_MAX_CHARS=1400
# MAX_RECOMMENDATIONS=20
# LEASE_QUOTE_MAX_CHARS=300
# RISK_SCORE_SCALE=10
# RISK_DECAY=0.85
# RISK_LABEL_MODERATE_AT=3
# RISK_LABEL_HIGH_AT=6
# LETTER_MAX_ISSUES=5
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# CATEGORY_WORKERS=6
